# Discord Bot
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Admin Panel OAuth2
CLIENT_SECRET=your_application_client_secret_here
OAUTH2_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Session secret (generate a long random string)
SESSION_SECRET=change_this_to_a_random_secret_string_at_least_32_chars

# Admin Panel
PANEL_PORT=3000

# Comma-separated list of Discord User IDs allowed to access admin panel
ADMIN_IDS=your_discord_user_id_here
